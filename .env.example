# Environment & System Settings
ENVIRONMENT=development
RANDOM_SEED=42
LOG_LEVEL=INFO

# API Server Settings
API_HOST=0.0.0.0
API_PORT=8000

# Directory Paths (Optional overrides; defaults to relative project paths)
# DATA_DIR=./data
# MODEL_DIR=./models

# Gemini Voice Assistant Settings (Optional; not required for basic backend startup)
GEMINI_API_KEY=""


GEMINI_MODEL=

# Database Settings (PostgreSQL)
# For local development or CI without PostgreSQL, defaults to sqlite:///./ppd_clinical_dev.db
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ppd_screening
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_ECHO=false

