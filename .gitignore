# Data directory rules: keep heavy, private, and generated datasets out of Git
data/raw/*
!data/raw/.gitkeep
!data/raw/README.md

data/processed/*
!data/processed/.gitkeep
!data/processed/README.md
!data/processed/Numerical/
data/processed/Numerical/*
!data/processed/Numerical/ppd_modeling_matrix.csv
!data/processed/Numerical/train_test_split_manifest.csv

data/synthetic/*
!data/synthetic/.gitkeep
!data/synthetic/README.md

# Explicitly ignore legacy and auxiliary datasets if present locally
data/Numerical/
data/Audio_feature/
data/Video_feature/
data/label/
data/NLP/
data/external_recieved/

# Local logs and temporary files
*.log
logs/
temp/
tmp/
